---
import { formatDate, getBlogs, getCategories } from "../../lib/microcms.js";

const [posts, categories] = await Promise.all([getBlogs(), getCategories()]);
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>ブログ</title>
  </head>
  <body>
    <h1>ブログ</h1>

    <nav class="category-nav" aria-label="カテゴリ">
      {
        categories.map((category) => (
          <span>{category.name}</span>
        ))
      }
    </nav>

    {
      posts.length === 0 ? (
        <p>記事はありません。</p>
      ) : (
        <div class="blog-list">
          {posts.map((item) => (
            <a class="blog-card" href={`/blog/${item.id}/`}>
              {item.eyecatch && (
                <img
                  src={item.eyecatch.url}
                  alt=""
                  width={item.eyecatch.width}
                  height={item.eyecatch.height}
                />
              )}
              <div class="blog-card-body">
                <div class="blog-meta">
                  {item.category && <span class="blog-category">{item.category.name}</span>}
                  <time datetime={item.publishedAt}>{formatDate(item.publishedAt)}</time>
                </div>
                <h2>{(item.title || "タイトル未設定").trim()}</h2>
              </div>
            </a>
          ))}
        </div>
      )
    }
  </body>
</html>

<style is:global>
  body {
    max-width: 800px;
    margin: 40px auto;
    padding: 0 16px;
    font-family: sans-serif;
    line-height: 1.8;
    color: #222;
  }

  a {
    color: inherit;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  .blog-list {
    display: grid;
    gap: 24px;
  }

  .blog-card {
    display: block;
    border: 1px solid #ddd;
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
  }

  .blog-card:hover {
    border-color: #999;
  }

  .blog-card img {
    display: block;
    width: 100%;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
  }

  .blog-card-body {
    padding: 16px;
  }

  .blog-card-body h2 {
    margin: 8px 0 0;
    font-size: 20px;
  }

  .blog-meta {
    display: flex;
    gap: 12px;
    align-items: center;
    color: #666;
    font-size: 14px;
  }

  .blog-category {
    padding: 2px 8px;
    border-radius: 4px;
    background: #eee;
    color: #333;
  }

  .category-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 24px;
  }

  .category-nav span {
    padding: 2px 10px;
    border-radius: 999px;
    background: #eee;
  }
</style>
